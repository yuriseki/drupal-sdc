{#
/**
 * @file
 * Transit Agency Card component template.
 *
 * Available variables:
 * - logo_url: URL or path to the agency logo image
 * - logo_alt: Alternative text for the agency logo
 * - heading: Agency name or card heading
 * - description: Descriptive text about the transit agency
 * - tags: Array of category/service type tag strings
 * - primary_button_label: Label for the primary action button
 * - primary_button_url: URL for the primary action button
 * - secondary_button_label: Label for the secondary action button
 * - secondary_button_url: URL for the secondary action button
 * - related_link_label: Label for the related external link
 * - related_link_url: URL for the related external link
 */
#}
<article class="transit-agency-card">
  <div class="transit-agency-card__logo-wrapper">
    <img
      src="{{ logo_url }}"
      alt="{{ logo_alt }}"
      class="transit-agency-card__logo"
    >
  </div>

  <div class="transit-agency-card__content">
    {% if tags %}
      <div class="transit-agency-card__tags">
        {% for tag in tags %}
          <span class="transit-agency-card__tag">
            <svg class="transit-agency-card__tag-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2c-4 0-8 .5-8 4v9.5C4 17.43 5.57 19 7.5 19L6 20.5v.5h2.23l2-2H14l2 2H18v-.5L16.5 19c1.93 0 3.5-1.57 3.5-3.5V6c0-3.5-3.58-4-8-4zm5.5 11H6.5V11h11v2zm0-4H6.5V7h11v2z" fill="currentColor"/>
            </svg>
            {{ tag }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <h3 class="transit-agency-card__heading">{{ heading }}</h3>

    {% if description %}
      <p class="transit-agency-card__description">{{ description }}</p>
    {% endif %}

    <div class="transit-agency-card__actions">
      <div class="transit-agency-card__buttons">
        {% if primary_button_label %}
          <a href="{{ primary_button_url }}" class="transit-agency-card__btn transit-agency-card__btn--primary">
            {{ primary_button_label }}
          </a>
        {% endif %}

        {% if secondary_button_label %}
          <a href="{{ secondary_button_url }}" class="transit-agency-card__btn transit-agency-card__btn--secondary" target="_blank" rel="noopener noreferrer">
            {{ secondary_button_label }}
            <svg class="transit-agency-card__btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" fill="currentColor"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {% if related_link_label %}
        <a href="{{ related_link_url }}" class="transit-agency-card__related-link" target="_blank" rel="noopener noreferrer">
          <span class="transit-agency-card__related-link-text">{{ related_link_label }}</span>
          <svg class="transit-agency-card__related-link-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" fill="currentColor"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</article>
